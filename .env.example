# ---- AI provider (primary) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Thinking controls are model-family specific — setting the wrong one is a 400.
#   Gemini 3.x / 4.x  -> GEMINI_THINKING_LEVEL=minimal|low|medium|high
#                        (3.x cannot fully disable thinking; "minimal" is the floor)
#   Gemini 2.5.x      -> GEMINI_THINKING_BUDGET=0   (0 disables, -1 dynamic)
GEMINI_THINKING_LEVEL=minimal
# GEMINI_THINKING_BUDGET=0

# ---- Optional OpenAI-compatible fallback ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Enrichment waterfall (cheapest first). Add one to leave demo mode. ----
ICYPEAS_API_KEY=
PROSPEO_API_KEY=
HUNTER_API_KEY=
